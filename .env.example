# ─────────────────────────────────────────────────────────────────────────────
# ThermopacAgent ERP — Environment Variables Template
# Copy this file to .env and fill in real values.
# NEVER commit .env to git.
# ─────────────────────────────────────────────────────────────────────────────

# ── Database ──────────────────────────────────────────────────────────────────
# PostgreSQL connection string (Replit managed database)
DATABASE_URL=postgresql://user:password@host:5432/dbname

# ── API Security ──────────────────────────────────────────────────────────────
# Secret key for signing internal API tokens (generate with: openssl rand -hex 32)
API_SECRET_KEY=

# ── SAP Business One (Service Layer) ─────────────────────────────────────────
SAP_SERVER_IP=
SAP_SERVICE_LAYER_URL=https://<sap-server>:50000/b1s/v1
SAP_SERVICE_LAYER_PORT=50000
SAP_USERNAME=
SAP_PASSWORD=
SAP_COMPANY_DB=
# JSON array of available company databases: ["DB1","DB2"]
SAP_COMPANY_DATABASES=

# ── SAP Middleware (optional proxy) ──────────────────────────────────────────
SAP_MIDDLEWARE_URL=
SAP_MIDDLEWARE_API_KEY=

# ── VPN (if SAP is behind VPN) ───────────────────────────────────────────────
SAP_VPN_ENABLED=false
VPN_SERVER_IP=
VPN_AUTO_RECONNECT=false

# ── Google Cloud (for document storage) ──────────────────────────────────────
GOOGLE_CLOUD_BUCKET=
# Service account key JSON (base64-encoded or raw JSON string)
GOOGLE_CLOUD_CREDENTIALS=
GOOGLE_REDIRECT_URI=

# ── Replit API ────────────────────────────────────────────────────────────────
# Used for agent node auto-registration in testing mode
REPLIT_API_KEY=

# ── Agent Auto-Registration ───────────────────────────────────────────────────
# Set to "true" to allow Windows agent nodes to self-register (testing mode only)
AGENT_AUTO_REGISTER=false
