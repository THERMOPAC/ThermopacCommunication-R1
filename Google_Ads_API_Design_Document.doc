h1 { font-size: 18pt; color: #1a73e8; border-bottom: 2px solid #1a73e8; padding-bottom: 8px; }
h2 { font-size: 14pt; color: #333; margin-top: 24px; }
h3 { font-size: 12pt; color: #555; }
