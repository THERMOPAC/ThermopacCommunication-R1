{
  "name": "thermopac-local-document-agent",
  "version": "1.0.72",
  "description": "THERMOPAC Local Windows Document Agent — saves ERP files to local file server",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "build:exe": "pkg dist/index.js --target node20-win-x64 --output ThermopacDocAgent.exe",
    "start": "node dist/index.js",
    "dev": "ts-node src/index.ts",
    "install-service": "node dist/index.js --install-service",
    "uninstall-service": "node dist/index.js --uninstall-service"
  },
  "dependencies": {
    "node-windows": "^1.0.0-beta.8",
    "winston": "^3.11.0"
  },
  "devDependencies": {
    "@types/node": "^20.11.0",
    "@yao-pkg/pkg": "^5.12.0",
    "ts-node": "^10.9.2",
    "typescript": "5.3.3"
  },
  "pkg": {
    "targets": [
      "node20-win-x64"
    ],
    "ignore": [
      "node_modules/node-windows/**"
    ]
  }
}
